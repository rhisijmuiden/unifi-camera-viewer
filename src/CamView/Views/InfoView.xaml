<UserControl x:Class="CamView.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CamView.Localization">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
      <TextBlock Style="{StaticResource H1}" Text="{Binding [Info], Source={x:Static loc:Loc.Instance}}" Margin="0,4"/>
    </Border>

    <Grid Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Style="{StaticResource H2}" Text="CamView"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="32"/>
              <RowDefinition Height="32"/>
              <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <TextBlock Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Text="{Binding [Version], Source={x:Static loc:Loc.Instance}}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" FontWeight="Bold"/>
              <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="4" BorderThickness="1"
                      Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}">
                <TextBlock x:Name="BuildChannelText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
              </Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Text="{Binding [ReleaseDate], Source={x:Static loc:Loc.Instance}}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DateText" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Text="{Binding [UpdateChannel], Source={x:Static loc:Loc.Instance}}"/>
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentBox}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ChannelProd" Style="{StaticResource Segment}" GroupName="channel" Checked="Channel_Checked"
                             Content="{Binding [Production], Source={x:Static loc:Loc.Instance}}"/>
                <RadioButton x:Name="ChannelTest" Style="{StaticResource Segment}" GroupName="channel" Checked="Channel_Checked"
                             Content="{Binding [Test], Source={x:Static loc:Loc.Instance}}"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Update result -->
          <Border x:Name="UpdatePanel" Margin="0,16,0,0" Padding="12" CornerRadius="6" BorderThickness="1"
                  Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed">
            <DockPanel>
              <Button x:Name="InstallButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Install_Click"
                      VerticalAlignment="Center"/>
              <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="UpdateTitle" FontWeight="Bold"/>
                <TextBlock x:Name="UpdateNotes" Style="{StaticResource Hint}" Margin="0,2,0,0" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
          <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Visibility="Collapsed" Maximum="100"
                       Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0"/>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="CheckButton" Click="Check_Click" Content="{Binding [CheckForUpdates], Source={x:Static loc:Loc.Instance}}"/>
            <Button x:Name="NotesButton" Margin="10,0,0,0" Click="Notes_Click" Visibility="Collapsed"
                    Content="{Binding [ReleaseNotes], Source={x:Static loc:Loc.Instance}}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- RHIS -->
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                     Text="{Binding [DevelopedBy], Source={x:Static loc:Loc.Instance}}"/>
          <Image Source="{DynamicResource RhisLogo}" Width="300" Margin="0,16" Cursor="Hand"
                 MouseLeftButtonUp="Rhis_Click" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Cursor="Hand"
                     MouseLeftButtonUp="Rhis_Click" Text="rhis.nl"/>
          <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}"/>
          <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                     Text="{Binding [LibVlcNotice], Source={x:Static loc:Loc.Instance}}"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
