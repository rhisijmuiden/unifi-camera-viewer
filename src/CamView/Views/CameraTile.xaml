<UserControl x:Class="CamView.Views.CameraTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:loc="clr-namespace:CamView.Localization">
  <Border Background="#000000" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
          CornerRadius="{StaticResource Radius}" Margin="6" ClipToBounds="True">
    <vlc:VideoView x:Name="Video">
      <!-- Overlay (rendered in LibVLCSharp's transparent foreground window). Near-transparent background catches mouse clicks. -->
      <Grid Background="#01000000" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border x:Name="LiveBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Background="{DynamicResource LiveBrush}" CornerRadius="4" Padding="7,2" Visibility="Collapsed">
          <TextBlock Text="{Binding [Live], Source={x:Static loc:Loc.Instance}}" Foreground="White"
                     FontSize="11" FontWeight="Bold"/>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Background="#88000000"
                CornerRadius="4" Padding="7,3" Cursor="Hand" MouseLeftButtonDown="FullScreen_Click"
                ToolTip="{Binding [FullScreen], Source={x:Static loc:Loc.Instance}}">
          <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="White" FontSize="12"/>
        </Border>
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource WarnBrush}"/>
          <TextBlock x:Name="StatusHint" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Text="{Binding [OfficeHint], Source={x:Static loc:Loc.Instance}}"/>
        </StackPanel>
        <TextBlock x:Name="NameText" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,12,10"
                   Foreground="White" FontWeight="SemiBold" FontSize="14">
          <TextBlock.Effect>
            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.9" Color="Black"/>
          </TextBlock.Effect>
        </TextBlock>
      </Grid>
    </vlc:VideoView>
  </Border>
</UserControl>
