<UserControl x:Class="CamView.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CamView.Localization">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="SavedText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource OkBrush}"
                     Text="{Binding [Saved], Source={x:Static loc:Loc.Instance}}" Visibility="Collapsed"/>
          <Button Style="{StaticResource PrimaryButton}" Click="Save_Click" Content="{Binding [Save], Source={x:Static loc:Loc.Instance}}"/>
        </StackPanel>
        <TextBlock Style="{StaticResource H1}" Text="{Binding [Settings], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <Grid Margin="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.3*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Cameras -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="{Binding [Cameras], Source={x:Static loc:Loc.Instance}}"/>
            <StackPanel x:Name="CameraList"/>

            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,6,0,0">
              <StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="{Binding [Name], Source={x:Static loc:Loc.Instance}}"/>
                <TextBox x:Name="NameBox"/>
                <TextBlock Style="{StaticResource Label}" Text="{Binding [StreamUrl], Source={x:Static loc:Loc.Instance}}"/>
                <TextBox x:Name="UrlBox" FontFamily="Consolas" FontSize="13"/>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding [StreamUrlHint], Source={x:Static loc:Loc.Instance}}"/>
                <TextBlock x:Name="FormMessage" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="AddButton" Style="{StaticResource PrimaryButton}" Click="AddOrUpdate_Click"
                          Content="{Binding [AddCamera], Source={x:Static loc:Loc.Instance}}"/>
                  <Button x:Name="TestButton" Margin="10,0,0,0" Click="Test_Click"
                          Content="{Binding [TestStream], Source={x:Static loc:Loc.Instance}}"/>
                  <Button x:Name="CancelEditButton" Margin="10,0,0,0" Click="CancelEdit_Click" Visibility="Collapsed"
                          Content="{Binding [Cancel], Source={x:Static loc:Loc.Instance}}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
          <!-- General -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="{Binding [General], Source={x:Static loc:Loc.Instance}}"/>
              <TextBlock Style="{StaticResource Label}" Margin="0,0,0,5" Text="{Binding [CompanyName], Source={x:Static loc:Loc.Instance}}"/>
              <TextBox x:Name="CompanyBox"/>
              <TextBlock Style="{StaticResource Label}" Text="{Binding [Language], Source={x:Static loc:Loc.Instance}}"/>
              <Border Style="{StaticResource SegmentBox}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="lang" Content="English"/>
                  <RadioButton x:Name="LangNl" Style="{StaticResource Segment}" GroupName="lang" Content="Nederlands"/>
                </StackPanel>
              </Border>
              <TextBlock Style="{StaticResource Label}" Text="{Binding [Theme], Source={x:Static loc:Loc.Instance}}"/>
              <Border Style="{StaticResource SegmentBox}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ThemeDark" Style="{StaticResource Segment}" GroupName="theme" Content="{Binding [Dark], Source={x:Static loc:Loc.Instance}}"/>
                  <RadioButton x:Name="ThemeLight" Style="{StaticResource Segment}" GroupName="theme" Content="{Binding [Light], Source={x:Static loc:Loc.Instance}}"/>
                  <RadioButton x:Name="ThemeSystem" Style="{StaticResource Segment}" GroupName="theme" Content="{Binding [System], Source={x:Static loc:Loc.Instance}}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Startup -->
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="{Binding [Startup], Source={x:Static loc:Loc.Instance}}"/>
              <CheckBox x:Name="AutoStartBox" Style="{StaticResource Toggle}" Margin="0,4"
                        Content="{Binding [StartWithWindows], Source={x:Static loc:Loc.Instance}}"/>
              <CheckBox x:Name="FullScreenBox" Style="{StaticResource Toggle}" Margin="0,10,0,4"
                        Content="{Binding [StartFullScreen], Source={x:Static loc:Loc.Instance}}"/>
            </StackPanel>
          </Border>

          <!-- Playback -->
          <Border Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="{Binding [Playback], Source={x:Static loc:Loc.Instance}}"/>
              <CheckBox x:Name="PlainRtspBox" Style="{StaticResource Toggle}">
                <TextBlock TextWrapping="Wrap" Text="{Binding [PreferPlainRtsp], Source={x:Static loc:Loc.Instance}}"/>
              </CheckBox>
              <TextBlock Style="{StaticResource Hint}" Text="{Binding [PreferPlainRtspHint], Source={x:Static loc:Loc.Instance}}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
