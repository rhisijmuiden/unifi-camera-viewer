<!-- CamView tokens voor WPF (licht). Laad als ResourceDictionary in App.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BgBrush" Color="#F4F6F8"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Panel2Brush" Color="#EEF1F4"/>
  <SolidColorBrush x:Key="LineBrush" Color="#DDE2E8"/>
  <SolidColorBrush x:Key="TextBrush" Color="#101418"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6472"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0F8C80"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B7369"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="LiveBrush" Color="#D92D20"/>
  <SolidColorBrush x:Key="OkBrush" Color="#079455"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#B54708"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#D92D20"/>
  <BitmapImage x:Key="RhisLogo" UriSource="pack://application:,,,/Assets/rhis-logo.png"/>
  <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/Assets/camview-icon-light.png"/>
</ResourceDictionary>
