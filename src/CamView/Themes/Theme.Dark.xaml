<!-- CamView tokens voor WPF (donker). Laad als ResourceDictionary in App.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="BgBrush" Color="#0D0F12"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#121519"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#181C21"/>
  <SolidColorBrush x:Key="Panel2Brush" Color="#20252C"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2A3038"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E9ECF1"/>
  <SolidColorBrush x:Key="TextMutedBrush" Color="#98A2B3"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#14B8A6"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#2DD4BF"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#0D0F12"/>
  <SolidColorBrush x:Key="LiveBrush" Color="#F04438"/>
  <SolidColorBrush x:Key="OkBrush" Color="#32D583"/>
  <SolidColorBrush x:Key="WarnBrush" Color="#FDB022"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#F97066"/>
  <BitmapImage x:Key="RhisLogo" UriSource="pack://application:,,,/Assets/rhis-logo-wit.png"/>
  <BitmapImage x:Key="AppIconImage" UriSource="pack://application:,,,/Assets/camview-icon.png"/>
</ResourceDictionary>
